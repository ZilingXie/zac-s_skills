#!/usr/bin/env bash
set -euo pipefail

skill_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pipeline_dir="$skill_dir/scripts/pipeline"
env_file="$skill_dir/.env"

if [[ ! -f "$env_file" ]]; then
  echo "error: missing $env_file; copy .env.example to .env and add AZURE_SPEECH_KEY" >&2
  exit 1
fi

exec uv run --project "$pipeline_dir" --env-file "$env_file" training-video "$@"
